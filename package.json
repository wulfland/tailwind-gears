{
  "name": "tailwind-gears",
  "private": true,
  "version": "0.1.0",
  "description": "A small cycling catalog for learning lean planning and AI-assisted delivery.",
  "engines": { "node": ">=24 <27" },
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "prebuild": "tsx scripts/copy-notices.ts",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts --production",
    "preview": "npm run start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:exercise": "node --import tsx --test exercises/search.acceptance.ts",
    "check": "npm test && npm run build",
    "assets": "tsx scripts/generate-assets.ts",
    "seed:issues": "tsx scripts/seed-issues.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "express": "^5.2.1",
    "lucide": "^1.47.0"
  }
}
